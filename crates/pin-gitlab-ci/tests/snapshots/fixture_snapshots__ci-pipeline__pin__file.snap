---
source: crates/pin-gitlab-ci/tests/fixture_snapshots.rs
expression: visible(&edited)
---
# CI for the dockerized PHP app (modeled on the docker-php-tutorial pipeline,
# https://www.pascallandau.com/blog/ci-pipeline-docker-php-gitlab-github/).
#
# Image references are pinned to immutable digests by pin-ci (pin-only mode).
# Non-Docker-Hub images are left untouched by design.

stages:
  - build
  - test
  - deploy

variables:
  APP_IMAGE: app/web
  COMPOSER_HOME: /tmp/composer
  DOCKER_TLS_CERTDIR: "/certs" # required for the docker:dind service

default:
  interruptible: true
  timeout: 10m

build:
  stage: build
  image: docker:24@sha256:5ecf2386da29ddf4ef406618941d1eaf932ddc889171ffc2efd0bcf866041632  # dind-capable docker client
  services:
    - name: docker:dind@sha256:09598440d4ea63ce9a92aa4c9ad934ac1def0c8328bb78d7c2e22213f94bcd4d
      alias: docker
  variables:
    DOCKER_BUILDKIT: "1"
  script:
    - docker build -t ${APP_IMAGE}:${CI_COMMIT_SHORT_SHA} .
    - docker tag ${APP_IMAGE}:${CI_COMMIT_SHORT_SHA} ${APP_IMAGE}:latest
    - docker push ${APP_IMAGE}:${CI_COMMIT_SHORT_SHA} || true
  rules:
    - if: '$CI_COMMIT_BRANCH == "main"'
    - if: '$CI_PIPELINE_SOURCE == "merge_request_event"'

lint:
  stage: test
  image: php:8.2-cli@sha256:bc7d158ce52acfbaec53ea3276374f6fdb7129f33ae121252a48543e6f767195
  script:
    - apk add --no-cache git
    - composer global require friendsofphp/php-cs-fixer
    - php-cs-fixer fix --dry-run --diff src/

test:
  stage: test
  image: php:8.2-cli@sha256:bc7d158ce52acfbaec53ea3276374f6fdb7129f33ae121252a48543e6f767195 # same image as lint; pin-ci must pin both lines
  services:
    - name: mysql:8.0@sha256:613a049308bbe05e11b12e1809655f0c260fb7cc11c4335fef0238660f5af825
      alias: mysql
      variables:
        MYSQL_ROOT_PASSWORD: root
        MYSQL_DATABASE: app_test
    - name: redis:7@sha256:7cb373721361c0f69081d459007586bc0b715da5c94249fa55e92dec6c18260e
      alias: redis
  variables:
    MYSQL_HOST: mysql
  script:
    - composer install --no-interaction --prefer-dist
    - vendor/bin/phpunit --log-junit .build/report.xml
  artifacts:
    when: always
    paths:
      - ".build/*.xml"
    expire_in: 1 week

smoke:
  stage: test
  image: alpine@sha256:ad64e3823df30f61db46f16ddc2c99dd4ddc3fc343ecad26304007c4bfb9d0f9 # tagless: pin-ci rewrites to alpine@sha256:...
  script:
    - apk add --no-cache curl
    - curl -fsS http://app:8080/healthcheck || true

# Self-built image from a variable: not resolvable, pin-ci must skip it.
publish:
  stage: deploy
  image: ${APP_IMAGE}:${CI_COMMIT_SHORT_SHA}
  services:
    - name: docker:dind@sha256:09598440d4ea63ce9a92aa4c9ad934ac1def0c8328bb78d7c2e22213f94bcd4d
      alias: docker
  script:
    - docker push ${APP_IMAGE}:${CI_COMMIT_SHORT_SHA}
  rules:
    - if: '$CI_COMMIT_TAG =~ /^v\d+\.\d+\.\d+$/'

# Runs on a GHCR image on purpose: pin-ci must skip non-Docker-Hub refs,
# never treat them as errors.
deploy-staging:
  stage: deploy
  image: ghcr.io/docker/buildx:v0.14.0@sha256:133be97dfea713edb2f839b9ab65366526778c68bfcab0484c2761647ad5daad
  script:
    - echo "staging deploy"
  rules:
    - if: '$CI_COMMIT_BRANCH == "main"'
